---
import { getImage } from 'astro:assets';
import bgImage from '@/assets/ui/emotional-cta-bg.webp';

const optimizedBg = await getImage({ src: bgImage, format: 'webp' });
---

<section
  class="relative py-20 md:py-24 px-4 sm:px-6 lg:px-8 flex items-center justify-center min-h-[600px] bg-fixed bg-center bg-cover"
  style={`background-image: url('${optimizedBg.src}');`}
>
  <!-- Dark Overlay -->
  <div class="absolute inset-0 bg-black/60"></div>

  <!-- Content -->
  <div
    class="relative z-10 text-center max-w-3xl mx-auto"
    data-animate="fade-in"
    style="opacity: 0"
  >
    <h2 class="text-4xl sm:text-5xl md:text-7xl text-white font-bold leading-tight mb-4 font-serif">
      Haz que este momento <br />
      <span class="italic font-medium text-gold">valga la pena</span>
    </h2>

    <p class="text-lg sm:text-xl text-cream mb-10 font-medium font-serif">
      No dejes pasar la oportunidad <br class="hidden sm:block" />
      de sorprender de verdad.
    </p>

    <!-- Small Decorative Line -->
    <div class="w-12 h-[1px] bg-gold mx-auto mb-10 opacity-70"></div>

    <a
      href="#productos"
      class="inline-block px-10 py-4 bg-gold hover:bg-gold-hover text-white text-sm font-bold uppercase tracking-widest transition-colors shadow-lg"
    >
      Comprar ahora
    </a>
  </div>
</section>
