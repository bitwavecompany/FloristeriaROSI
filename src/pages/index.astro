---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/ui/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import Gallery from '@/components/sections/Gallery.astro';
import CtaBanner from '@/components/ui/CtaBanner.astro';
import Services from '@/components/sections/Services.astro';
import EmotionalCta from '@/components/ui/EmotionalCta.astro';
import FindUs from '@/components/sections/FindUs.astro';
import Footer from '@/components/ui/Footer.astro';
---

<Layout
  title="Floristeria ROSI | Flores para cada ocasión"
