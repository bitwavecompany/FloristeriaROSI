---
import Layout from '@/layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout
  title="Página no encontrada | Floristeria ROSI"
  description="No pudimos encontrar la página que buscas. Regresa al inicio para ver nuestros arreglos florales."
>
  <main class="min-h-[calc(100vh-5rem)] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="max-w-2xl w-full text-center z-10" data-animate="fade-up" style="opacity: 0">
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-light-wisteria-100 text-light-wisteria-400 mb-8 shadow-sm">
        <Icon name="lucide:flower-2" class="w-12 h-12" />
      </div>
      
      <h1 class="text-5xl md:text-6xl font-serif text-light-wisteria-950 mb-6 tracking-tight">
        Esta página se ha marchitado.
      </h1>
      
      <p class="text-lg md:text-xl text-light-wisteria-700 font-sans font-light mb-10 max-w-lg mx-auto">
        No logramos encontrar lo que buscabas. Tal vez el enlace sea antiguo o la página haya cambiado de lugar.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/"
          class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-sm font-semibold rounded text-white bg-light-wisteria-700 hover:bg-light-wisteria-900 transition-colors uppercase tracking-widest w-full sm:w-auto shadow-md hover:shadow-lg"
        >
          Volver al inicio
        </a>
        <a
          href="https://wa.me/593999636096"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-4 border border-light-wisteria-300 text-sm font-semibold rounded text-light-wisteria-900 bg-white/50 backdrop-blur-sm hover:bg-light-wisteria-100 transition-colors uppercase tracking-widest w-full sm:w-auto shadow-sm hover:shadow-md group"
        >
          <Icon name="mdi:whatsapp" class="w-5 h-5 mr-2 text-whatsapp group-hover:scale-110 transition-transform" />
          Contáctanos
        </a>
      </div>
    </div>
  </main>
</Layout>
